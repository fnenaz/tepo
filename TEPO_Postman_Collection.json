            "body": {
              "mode": "raw",
              "raw": "{\n  \"period\": \"Sore\",\n  \"entry_time\": \"16:40\",\n  \"mood_level\": -2,\n  \"energy_level\": 1,\n  \"daily_notes\": \"Energi turun drastis di sore hari, ingat penyesalan mendalam\"\n}"
            },
