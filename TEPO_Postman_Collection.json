    {
      "name": "2. Multi-Mood & Energi (-3 s/d +3)",
      "item": [
        {
          "name": "Ambil Dashboard Pasien",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patient/dashboard",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "dashboard"]
            }
          }
        },
        {
          "name": "Catat Mood Pagi (Manik +3)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Mood Pagi berhasil dicatat (201 Created)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (res.data && res.data.id) {",
                  "    pm.collectionVariables.set('mood_id', String(res.data.id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"period\": \"Pagi\",\n  \"entry_time\": \"08:15\",\n  \"mood_level\": 3,\n  \"energy_level\": 5,\n  \"daily_notes\": \"Banyak bicara, muncul banyak ide tugas sekaligus, ingin belanja impulsif\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/patient/mood",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "mood"]
            }
          }
        },
        {
          "name": "Catat Mood Sore (Depresi -2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
