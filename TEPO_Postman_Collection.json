    {
      "name": "6. Konsultasi Anonim Dua Arah (DEMO)",
      "item": [
        {
          "name": "Lihat Daftar Konsultasi Anonim",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/consultations",
              "host": ["{{base_url}}"],
              "path": ["api", "consultations"]
            }
          }
        },
        {
          "name": "Mulai Sesi Konsultasi Anonim Baru (Pasien)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Sesi konsultasi anonim berhasil dibuat (201 Created)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (res.data && res.data.id) {",
                  "    pm.collectionVariables.set('consultation_id', String(res.data.id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Pagi ini saya merasa sangat bertenaga dan sulit tidur, ingin bercerita secara anonim\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/consultations",
              "host": ["{{base_url}}"],
              "path": ["api", "consultations"]
            }
          }
        },
        {
          "name": "Lihat Detail & Pesan Ruang Obrolan Anonim",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const text = pm.response.text();",
                  "pm.test('Tidak membocorkan email atau kata sandi lawan bicara', function () {",
                  "    pm.expect(text).to.not.include('@tepo.test');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/consultations/{{consultation_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "consultations", "{{consultation_id}}"]
            }
          }
        },
        {
          "name": "Kirim Pesan Obrolan Anonim",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Saya khawatir kalau bercerita terbuka identitas saya ketahuan, lega rasanya bisa berbicara anonim di sini.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/consultations/{{consultation_id}}/messages",
              "host": ["{{base_url}}"],
              "path": ["api", "consultations", "{{consultation_id}}", "messages"]
            }
          }
        },
        {
          "name": "Ubah Status Sesi Konsultasi",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/consultations/{{consultation_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "consultations", "{{consultation_id}}", "status"]
            }
          }
        }
      ]
