          "name": "Ambil Laporan & Evaluasi 14 Hari",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patient/reports?days=14",
