{
  "info": {
    "_postman_id": "tepo-clinical-api-v1",
    "name": "TEPO (Teman Bipolar) - API Testing Collection",
    "description": "Koleksi pengujian REST API TEPO menggunakan Postman: Autentikasi (Bearer Token & Session Cookie), Pencatatan Multi-Mood (-3 s/d +3) & Energi (1-5), Jam Tidur, Multi-Resep Obat, Laporan Klinis 2 Minggu, Konsultasi Anonim Dua Arah (DEMO), dan Manajemen Rekomendasi Admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "mood_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "prescription_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "medication_log_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "consultation_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "recommendation_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Autentikasi",
      "item": [
        {
          "name": "Register Akun Pasien Baru",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status code adalah 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pasien Uji Postman\",\n  \"email\": \"uji.postman{{$timestamp}}@tepo.test\",\n  \"phone\": \"081234567899\",\n  \"role\": \"patient\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
            },
